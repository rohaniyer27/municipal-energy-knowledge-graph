@prefix ex: <https://example.org/municipal-energy/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:EnergyObservationShape a sh:NodeShape ;
    sh:targetClass ex:EnergyObservation ;
    sh:property [
        sh:path ex:energyKWh ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path ex:reportingYear ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ex:source ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ex:originalUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
